<div id="world-map-library" class="min-h-[800px] p-4">
  <section class="stone-panel overflow-hidden rounded-md border shadow-sm">
    <div class="stone-border flex flex-wrap items-center justify-between gap-3 border-b px-4 py-3">
      <div>
        <p class="stone-muted text-[11px] font-semibold uppercase tracking-wide">
          {@world.name}
        </p>
        <h2 class="stone-heading text-base font-semibold">World maps</h2>
      </div>
      <.link
        id="map-library-new"
        patch={~p"/worlds/#{@world}/dashboard?section=map&new_map=true"}
        class="stone-primary-button inline-flex items-center gap-2 rounded-md border px-3 py-2 text-xs font-semibold shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <.icon name="hero-plus" class="size-4" /> New map
      </.link>
    </div>

    <div id="world-map-list" class="grid gap-3 p-4 md:grid-cols-2 xl:grid-cols-3">
      <div
        :if={@map_documents == []}
        id="world-map-list-empty"
        class="stone-muted rounded-md border border-dashed p-8 text-center md:col-span-2 xl:col-span-3"
      >
        <.icon name="hero-map" class="mx-auto size-8 opacity-50" />
        <p class="stone-heading mt-3 text-sm font-semibold">No maps yet</p>
        <p class="mt-1 text-xs">Create this world's first outer or inner map.</p>
      </div>

      <article
        :for={map <- @map_documents}
        id={"world-map-card-#{map.id}"}
        class="stone-button group flex h-full flex-col rounded-md border p-4 transition hover:-translate-y-0.5 hover:shadow-md"
      >
        <%= if @editing_map_id == map.id do %>
          <.form
            for={@map_name_form}
            id={"world-map-name-form-#{map.id}"}
            phx-submit="save_map_name"
            class="flex flex-1 flex-col"
          >
            <input type="hidden" name="_map_id" value={map.id} />
            <input type="hidden" name="_lock_version" value={map.lock_version} />
            <.input field={@map_name_form[:name]} label="Map name" required />
            <div class="mt-auto flex items-center justify-end gap-2 pt-4">
              <button
                id={"world-map-name-cancel-#{map.id}"}
                type="button"
                phx-click="cancel_map_name_edit"
                class="stone-button rounded-md border px-3 py-2 text-xs font-semibold transition"
              >
                Cancel
              </button>
              <button
                id={"world-map-name-save-#{map.id}"}
                type="submit"
                class="stone-primary-button rounded-md border px-3 py-2 text-xs font-semibold transition"
              >
                Save
              </button>
            </div>
          </.form>
        <% else %>
          <.link
            id={"world-map-#{map.id}"}
            patch={~p"/worlds/#{@world}/dashboard?section=map&map_id=#{map.id}"}
            class="block flex-1"
          >
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="stone-muted text-[10px] font-semibold uppercase tracking-[0.16em]">
                  {if map.parent_map,
                    do: "Inside #{map.parent_map.name}",
                    else: "Outer map"}
                </p>
                <h3
                  id={"world-map-name-#{map.id}"}
                  class="stone-heading mt-1 truncate text-base font-semibold"
                >
                  {map.name}
                </h3>
              </div>
              <span class="rounded-full border px-2 py-1 text-[10px] font-semibold uppercase tracking-wide">
                {map.kind}
              </span>
            </div>
            <p
              :if={map.description not in [nil, ""]}
              class="stone-muted mt-3 line-clamp-2 text-xs"
            >
              {map.description}
            </p>
          </.link>
          <div class="mt-auto flex flex-wrap items-center justify-between gap-3 pt-4">
            <.link
              id={"world-map-open-#{map.id}"}
              patch={~p"/worlds/#{@world}/dashboard?section=map&map_id=#{map.id}"}
              class="stone-heading inline-flex items-center gap-1 text-xs font-semibold"
            >
              Open editor
              <.icon
                name="hero-arrow-right"
                class="size-3.5 transition group-hover:translate-x-0.5"
              />
            </.link>
            <div class="flex items-center gap-2">
              <button
                id={"world-map-name-edit-#{map.id}"}
                type="button"
                phx-click="edit_map_name"
                phx-value-id={map.id}
                class="stone-button inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1.5 text-xs font-semibold transition"
              >
                <.icon name="hero-pencil-square" class="size-3.5" /> Edit
              </button>
              <button
                id={"world-map-delete-#{map.id}"}
                type="button"
                phx-click="delete_map"
                phx-value-id={map.id}
                data-confirm="Delete this map? Inner maps will become outer maps."
                aria-label={"Delete #{map.name}"}
                class="stone-button inline-flex shrink-0 items-center gap-1.5 rounded-md border px-2.5 py-1.5 text-xs font-semibold transition"
              >
                <.icon name="hero-trash" class="size-3.5" /> Delete
              </button>
            </div>
          </div>
        <% end %>
      </article>
    </div>
  </section>
</div>
